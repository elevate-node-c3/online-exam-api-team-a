{
  "info": {
    "_postman_id": "b6a2f2b0-6e2a-4c9a-9c1a-online-exam-api",
    "name": "Online Exam API",
    "description": "Collection covering the currently-implemented routes: auth (signup/login/forgot-password flow) and quiz (create/update/list/get). Base URL and a few IDs are collection variables so you can fill them in once and reuse them across requests.\n\nAuth: Login sets an `accessToken` cookie on success, which Postman's cookie jar carries automatically to later requests against the same `baseUrl` — run Login once per session before hitting quiz routes, all of which now require authentication.\n\nRoles: every new user registers as role `user`. Create/Update Quiz require role `admin`, so to exercise those two requests you'll need to manually set a user's `role` to `admin` in the database first (there's no self-serve way to become admin through the API, by design). List/Get Quiz work for either role.\n\nNote on `questions`/`instructions`: these are JSON-stringified inside a text form-data field (multipart can't carry nested arrays natively) — the server parses that string back into an array before validation. `instructions` on Create Quiz is currently omitted below since only `questions` has that parsing wired up so far.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "student@example.com" },
    { "key": "otp", "value": "123456" },
    { "key": "diplomaId", "value": "000000000000000000000000" },
    { "key": "quizId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Passw0rd!\",\n  \"confirmPassword\": \"Passw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "firstName/lastName require min length 2. password/confirmPassword must match. On success, an accessToken cookie is set and the created user + token are returned in the response body."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Passw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Note: this route is a GET with a body in the current implementation. On success, an accessToken cookie is set and the token is also returned in the response body."
          }
        },
        {
          "name": "Send Forgot-Password OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Sends a 6-digit OTP to the given email if a matching user exists. The OTP expires in 2 minutes."
          }
        },
        {
          "name": "Verify Forgot-Password OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password", "verify-otp"]
            },
            "description": "otp must be exactly 6 digits."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"newPassword\": \"NewPassw0rd!\",\n  \"confirmPassword\": \"NewPassw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Requires the OTP to have been verified first. newPassword must be 8+ chars with at least one uppercase letter, one number, and one symbol, and must match confirmPassword."
          }
        }
      ]
    },
    {
      "name": "Quiz",
      "item": [
        {
          "name": "Create Quiz",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "quizName", "value": "Intro to Networking Final", "type": "text" },
                { "key": "description", "value": "Covers OSI layers, IP addressing, and routing basics.", "type": "text" },
                { "key": "time", "value": "60", "type": "text" },
                { "key": "passingThreshold", "value": "70", "type": "text" },
                { "key": "diplomaId", "value": "{{diplomaId}}", "type": "text" },
                {
                  "key": "questions",
                  "value": "[{\"text\":\"Which layer handles routing?\",\"type\":\"radio\",\"options\":[{\"text\":\"Physical\"},{\"text\":\"Network\"},{\"text\":\"Session\"}],\"correctOptionIndex\":[1]},{\"text\":\"Which of these are private IP ranges?\",\"type\":\"check\",\"options\":[{\"text\":\"10.0.0.0/8\"},{\"text\":\"8.8.8.8\"},{\"text\":\"192.168.0.0/16\"}],\"correctOptionIndex\":[0,2]}]",
                  "type": "text"
                },
                { "key": "quizPhoto", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes"]
            },
            "description": "Requires an admin session (log in as a user with role=admin first). time: 30-120. passingThreshold: 20-100 (optional, defaults server-side if omitted). questions: 1-10 items, JSON-stringified (see collection-level note); each question needs 1+ options and 1+ correctOptionIndex; a 'radio' question must have exactly 1 correct index. quizPhoto is required."
          }
        },
        {
          "name": "Update Quiz",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "quizName", "value": "Intro to Networking Final (v2)", "type": "text" },
                { "key": "passingThreshold", "value": "75", "type": "text" },
                { "key": "quizPhoto", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes", "{{quizId}}"]
            },
            "description": "Requires an admin session (log in as a user with role=admin first). All fields are optional (partial update) — only send the ones you want to change. quizPhoto is optional here, unlike on create."
          }
        },
        {
          "name": "List Quizzes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quizzes?query=&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes"],
              "query": [
                { "key": "query", "value": "", "description": "Optional text search against quizName/description" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Requires any authenticated user (user or admin). page/size are optional — omit both to get all matching quizzes without pagination metadata."
          }
        },
        {
          "name": "Get Quiz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes", "{{quizId}}"]
            },
            "description": "Requires any authenticated user (user or admin). 404s if the quiz doesn't exist."
          }
        },
        {
          "name": "Delete Quiz",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes", "{{quizId}}"]
            },
            "description": "Requires an admin session (log in as a user with role=admin first). 404s if the quiz doesn't exist."
          }
        }
      ]
    },
    {
      "name": "Attempts",
      "item": [
        {
          "name": "Start Attempt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/quizzes/{{quizId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["quizzes", "{{quizId}}", "start"]
            },
            "description": "Requires an authenticated user. Creates one in-progress attempt and returns sanitized question/option snapshots. Copy `attemptId` from the response into the collection variable before running the detail or submit requests. A user may have only one active attempt at a time."
          }
        },
        {
          "name": "List Attempts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attempts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["attempts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10", "description": "Maximum 100" }
              ]
            },
            "description": "Requires an authenticated user. Returns only the current user's attempts, newest first, with pagination metadata."
          }
        },
        {
          "name": "Get Attempt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}",
              "host": ["{{baseUrl}}"],
              "path": ["attempts", "{{attemptId}}"]
            },
            "description": "Requires an authenticated user and an attempt owned by that user. Correct answers are revealed only after submission."
          }
        },
        {
          "name": "Submit Attempt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionOneId}}\",\n      \"selectedOptionIds\": [\"{{optionOneId}}\"]\n    },\n    {\n      \"questionId\": \"{{questionTwoId}}\",\n      \"selectedOptionIds\": [\"{{optionTwoId}}\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["attempts", "{{attemptId}}", "submit"]
            },
            "description": "Requires an authenticated user. Submit exactly one answer object for every question in the attempt. Option sets are graded exactly (no partial credit); the server calculates score, passed, and time spent. A submitted or expired attempt returns 409."
          }
        }
      ]
    },
    {
      "name": "Diploma",
      "item": [
        {
          "name": "Create Diploma",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "diplomaName",
                  "value": "Frontend Development",
                  "type": "text"
                },
                {
                  "key": "diplomaDescription",
                  "value": "Covers modern frontend development fundamentals.",
                  "type": "text"
                },
                {
                  "key": "diplomaPhoto",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/diplomas",
              "host": ["{{baseUrl}}"],
              "path": ["diplomas"]
            },
            "description": "Requires an authenticated admin. diplomaPhoto is optional and accepts JPEG, PNG, or WebP files up to 2 MB."
          }
        },
        {
          "name": "List Diplomas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/diplomas",
              "host": ["{{baseUrl}}"],
              "path": ["diplomas"]
            },
            "description": "Requires any authenticated user. Photo values are public paths under /uploads/diploma-photos, or null when no photo was uploaded."
          }
        }
      ]
    }
  ]
}
